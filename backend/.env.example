# ── Server ───────────────────────────────────────────────────
NODE_ENV=development          # production in prod (enables strict JWT_SECRET check)
PORT=5000
# Public URL of the frontend: used in email/Telegram links, CORS and CSP.
FRONTEND_URL=http://localhost:3000
# Extra allowed CORS origins, comma-separated (optional)
ALLOWED_ORIGINS=
# Behind nginx/Render/Heroku set to 1 (number of proxy hops) so rate limiting sees real client IPs
TRUST_PROXY=

# ── Auth ─────────────────────────────────────────────────────
# REQUIRED in production, min 32 chars:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_GRACE_SECONDS=86400   # how long after expiry a token can still be refreshed

# ── Rate limits ──────────────────────────────────────────────
API_RATE_LIMIT_MAX=500        # per IP / 15 min
BACKTEST_RATE_LIMIT_MAX=20

# ── Database (PostgreSQL) — either DATABASE_URL or the DB_* vars ──
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atlasquant
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=20
DB_SSL=                           # false = no TLS (docker-compose db) | true = force TLS for DB_* vars; with DATABASE_URL TLS is on in production unless false
DB_SSL_REJECT_UNAUTHORIZED=true   # set false ONLY for providers with self-signed certs

# ── Exchange API-key encryption (AES-256-GCM) ────────────────
# 64 hex chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXCHANGE_ENCRYPTION_KEY=
PAPER_START_CAPITAL=10000

# ── Trading safety ───────────────────────────────────────────
RISK_STRICT_LIVE=true                    # refuse LIVE orders when Settings->Risk limits can't be verified
REQUIRE_VERIFIED_EMAIL_FOR_LIVE=true     # verified email needed to connect/switch/trade LIVE
# Global kill-switch for REAL orders: while true, placeLiveOrder() refuses every live order
# (HTTP 403 PAPER_TRADING_ENABLED). Set to false ONLY when you really want to trade live.
PAPER_TRADING=true
MAX_RISK_PER_TRADE=0.02
MAX_DAILY_DRAWDOWN=0.10

# ── Market data (stocks route) ───────────────────────────────
# PRICES_ALLOWED_SYMBOLS=AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AMD,PLTR   # supported stock universe
# PRICES_DEMO_MODE=false     # true = serve hardcoded demo prices (flagged isDemo) when Yahoo fails. Never in production.

# ── Third-party APIs / notifications (all optional) ──────────
GROQ_API_KEY=
COINGECKO_API_KEY=
CMC_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
TELEGRAM_BOT_TOKEN=
# (TELEGRAM_CHAT_ID n'est plus utilisé : chaque user lie son propre chat dans Settings)
EMAIL_USER=
EMAIL_PASS=                   # Gmail app password

# ── Operations (Audit 4) ─────────────────────────────────────
# Emergency stop for NEW orders (manual + auto-trader). true = refuse every new order with 503 TRADING_DISABLED.
TRADING_KILL_SWITCH=false
# Enables POST/GET /api/admin/kill-switch (header X-Admin-Key). 24+ random chars; empty = endpoint disabled (404).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=
