# Variables read by docker-compose.yml (put them in a root `.env` file, which is git-ignored, or in your shell).
# The backend's own settings stay in backend/.env (see backend/.env.example).

# Postgres password for the `db` service and the backend (required)
DB_PASSWORD=

# Shared secret between the backend and ai-service (required, 32+ random characters)
AI_SERVICE_KEY=

# Public URL of the frontend (CORS / cookies) and of the API as seen by the browser
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=ws://localhost:5000

# Number of trusted proxies in front of the backend (1 with the bundled nginx edge); empty = none
TRUST_PROXY=
